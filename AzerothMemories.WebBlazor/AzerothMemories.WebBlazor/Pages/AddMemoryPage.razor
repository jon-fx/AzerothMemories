@page "/addmemory/"
@inherits MoaComponentBase<AddMemoryPageViewModel>
@inject RenderModeHelper RenderModeHelper

@{
    var pageHeaderInfo = new DefaultPageHeaderInfo("Add Memory");
    <HeadContentTest ClientServices="@ClientServices" PageInfo="@pageHeaderInfo" />
}

<AuthorizeView>
    <Authorized>
        @if (RenderModeHelper.CurrentMode != RenderModeDef.GetOrDefault("w"))
        {
            <MudCard Class="@ClassPresets.Card" Outlined="true" Elevation="10">
                <MudCardContent Class="@ClassPresets.CardContent">
                    <MudButton Class="@ClassPresets.DefaultPadding" Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" IconColor="Color.Secondary" StartIcon="@Icons.Material.Filled.Wysiwyg" OnClick="OnStartClicked">Start</MudButton>
                </MudCardContent>
            </MudCard>
        }
        else if (ViewModel.UploadedImages.Count > 0 || _skipAddImage)
        {
            <AddMemoryComponent Services="@(this)" ViewModel="@ViewModel" OnPostMemoryResult="@OnPostMemoryCallback"/>
        }
        else
        {
            <MudCard Class="@ClassPresets.Card" Outlined="true" Elevation="10">
                <MudCardContent Class="@ClassPresets.CardContent">
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept="@ZExtensions.UploadAcceptExtensions" FilesChanged="ViewModel.Initialize" MaximumFileCount="10000">
                        <ActivatorContent>
                            <MudButton Class="@ClassPresets.DefaultPadding" HtmlTag="label" Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" IconColor="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload">Upload Image</MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton Class="@ClassPresets.DefaultPadding" Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" IconColor="Color.Secondary" StartIcon="@Icons.Material.Filled.ImageNotSupported" OnClick="OnSkipClicked">Continue</MudButton>
                </MudCardContent>
            </MudCard>
        }
    </Authorized>
</AuthorizeView>

@code
{
    private bool _skipAddImage;

    private void OnStartClicked(MouseEventArgs obj)
    {
        RenderModeHelper.ChangeMode(RenderModeDef.GetOrDefault("w"));
    }

    private async Task OnSkipClicked()
    {
        _skipAddImage = true;

        await ViewModel.Initialize(null);

        StateHasChanged();
    }

    private async Task OnPostMemoryCallback(AddMemoryResult result)
    {
        if (result.Result == AddMemoryResultCode.Success)
        {
            ClientServices.NavigationManager.NavigateTo($"post/{result.AccountId}/{result.PostId}");
        }
        else if (result.Result == AddMemoryResultCode.Canceled)
        {
            _skipAddImage = false;
        }
        else
        {
            await ClientServices.DialogService.ShowNotificationDialog(false, $"{result.Result}");
        }

        StateHasChanged();
    }
}