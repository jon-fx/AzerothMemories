@page "/"
@inherits MoaComponentBase<IndexPageViewModel>

@{
    var pageHeaderInfo = new DefaultPageHeaderInfo();
    <HeadContentTest ClientServices="@ClientServices" PageInfo="@pageHeaderInfo" />
}

<AuthorizeView>
    <Authorized>
        <AccountHeaderCardComponent Services="@(this)" AccountViewModel="@ViewModel.AccountViewModel" />
    </Authorized>
</AuthorizeView>

<OnThisDayHeader HeaderData="@ViewModel.OnThisDay" Services="@(this)" />

<RecentPostsComponent Services="@(this)" 
                      AccountViewModel="@ViewModel.AccountViewModel"
                      SearchResults="@ViewModel.SearchResults"
                      IsLoading="@ViewModel.RecentPostsHelper.IsLoading" 
                      OnTryChangeShowAllEventCallback="ViewModel.RecentPostsHelper.OnTryChangeShowAll"
                      OnTryChangePageEventCallback="ViewModel.RecentPostsHelper.OnTryChangePage" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string CurrentPage { get; init; }

    [Parameter, SupplyParameterFromQuery(Name = "type")] public string RecentPostType { get; init; }

    protected override void OnParametersChanged()
    {
        base.OnParametersChanged();

        ViewModel.OnParametersChanged(CurrentPage, null, RecentPostType);
    }
}