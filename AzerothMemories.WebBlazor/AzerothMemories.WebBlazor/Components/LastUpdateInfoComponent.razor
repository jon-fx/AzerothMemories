@if (UpdateViewModel == null || UpdateViewModel.IsLoadingFromArmory)
{
    <MudText>No Data</MudText>
}
else
{
    var main = GetIconAndColor(UpdateViewModel.Children.All(x => x.UpdateJobLastResult.IsSuccess2()));
    var endTimeAsString = Services.ClientServices.TimeProvider.GetTimeAsLocalStringAgo(UpdateViewModel.UpdateJobLastEndTime, true);

    <MudMenu Icon="@main.Icon" Color="@main.IconColor" Size="Size.Small" Dense="true" ActivationEvent="MouseEvent.MouseOver">
        <MudMenuItem Disabled="true">
            <MudText Typo="Typo.subtitle1" Style="@($"color:{MainTheme.Theme.PaletteDark.TextPrimary};")">
                @endTimeAsString
            </MudText>
        </MudMenuItem>

        @if (TokenExpiryTime > 0)
        {
            var tokenExpiryInstant = Instant.FromUnixTimeMilliseconds(TokenExpiryTime);
            var currentInstant = SystemClock.Instance.GetCurrentInstant();
            var tokenExpired = currentInstant > tokenExpiryInstant.Minus(Duration.FromHours(1));
            var tokenExpiryTimeString = Services.ClientServices.TimeProvider.GetTimeAsLocalStringAgo(TokenExpiryTime, true);
            var tokenExpiredRow = GetIconAndColor(!tokenExpired);
            var textColor = tokenExpired ? MainTheme.Theme.PaletteDark.Error : MainTheme.Theme.PaletteDark.TextPrimary;

            <MudMenuItem IconColor="@tokenExpiredRow.IconColor" Icon="@tokenExpiredRow.Icon" Disabled="true">
                <MudText Typo="Typo.subtitle2" Style="@($"color:{textColor};")">
                    0: Token - @tokenExpiryTimeString
                </MudText>
            </MudMenuItem>
        }

        @foreach (var child in UpdateViewModel.Children)
        {
            var row = GetIconAndColor(child.UpdateJobLastResult.IsSuccess2());

            <MudMenuItem IconColor="@row.IconColor" Icon="@row.Icon" Disabled="true">
                <MudText Typo="Typo.body2" Style="@($"color:{MainTheme.Theme.PaletteDark.TextPrimary};")">
                    @child.Id: @child.UpdateTypeString - @child.UpdateJobLastResult (@((int)child.UpdateJobLastResult))
                </MudText>
            </MudMenuItem>
        }

        @if (Services.ClientServices.ActiveAccountServices.AccountViewModel.IsAdmin())
        {
            <MudMenuItem IconColor="@Color.Warning" Icon="@Icons.Material.Filled.AddToQueue" OnClick="ResetUpdateStatus">
                <MudText Typo="Typo.body2" Color="Color.Warning">
                    Reset Update Status
                </MudText>
            </MudMenuItem>
        }
    </MudMenu>
}

@code 
{
    [Parameter, EditorRequired] public required IMoaServices Services { get; init; }

    [Parameter, EditorRequired] public required BlizzardUpdateViewModel? UpdateViewModel { get; init; }

    [Parameter, EditorRequired] public long TokenExpiryTime { get; init; }

    private (string Icon, Color IconColor) GetIconAndColor(bool isSuccess)
    {
        if (isSuccess)
        {
            return (Icons.Material.Filled.Check, Color.Success);
        }

        return (Icons.Material.Filled.Warning, Color.Warning);
    }

    private async Task ResetUpdateStatus(MouseEventArgs arg)
    {
        if (UpdateViewModel == null)
        {
            return;
        }

        await Services.ClientServices.CommandRunner.Run(new Updates_TryResetUpdateStatus(Services.ClientServices.Session,  UpdateViewModel.Id));
    }
}