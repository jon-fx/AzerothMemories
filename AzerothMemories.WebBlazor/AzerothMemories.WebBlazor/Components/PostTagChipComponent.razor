@if (TagInfo == null)
{

}
else if (TagInfo.WowHeadLink == null)
{
    @if (TagInfo.IsChipClosable)
    {
        <MudChip @key="TagInfo.TagString" Variant="@Variant" Color="TagInfo.GetChipColor()" SelectedColor="TagInfo.GetChipSelectedColor()" Default="Default" Value="TagInfo" Selected="@IsSelected" OnClick="OnClick" OnClose="OnClose">
            @if (TagInfo.Image != null)
            {
                <MudAvatar Class="mr-2" Size="Size.Small">
                    <MudImage Src="@TagInfo.Image" loading="lazy" />
                </MudAvatar>
            }

            @TagInfo.NameWithIcon
        </MudChip>
    }
    else
    {
        <MudChip @key="TagInfo.TagString" Variant="@Variant" Color="TagInfo.GetChipColor()" SelectedColor="TagInfo.GetChipSelectedColor()" Default="Default" Value="TagInfo" Selected="@IsSelected" OnClick="OnClick">
            @if (TagInfo.Image != null)
            {
                <MudAvatar Class="mr-2" Size="Size.Small">
                    <MudImage Src="@TagInfo.Image" loading="lazy" />
                </MudAvatar>
            }

            @TagInfo.NameWithIcon
        </MudChip>
    }
}
else
{
    <a class="cardlink2" data-wowhead="@TagInfo.WowHeadLink" href="" onclick="return false;">
        @if (TagInfo.IsChipClosable)
        {
            <MudChip @key="TagInfo.TagString" Variant="@Variant" Color="TagInfo.GetChipColor()" SelectedColor="TagInfo.GetChipSelectedColor()" Default="Default" Value="TagInfo" Selected="@IsSelected" OnClick="OnClick" OnClose="OnClose">
                @if (TagInfo.Image != null)
                {
                    <MudAvatar Class="mr-2" Size="Size.Small">
                        <MudImage Src="@TagInfo.Image" loading="lazy" />
                    </MudAvatar>
                }

                @TagInfo.NameWithIcon
            </MudChip>
        }
        else
        {
            <MudChip @key="TagInfo.TagString" Variant="@Variant" Color="TagInfo.GetChipColor()" SelectedColor="TagInfo.GetChipSelectedColor()" Default="Default" Value="TagInfo" Selected="@IsSelected" OnClick="OnClick">
                @if (TagInfo.Image != null)
                {
                    <MudAvatar Class="mr-2" Size="Size.Small">
                        <MudImage Src="@TagInfo.Image" loading="lazy" />
                    </MudAvatar>
                }

                @TagInfo.NameWithIcon
            </MudChip>
        }
    </a>
}

@code {
    
    [Parameter, EditorRequired] public required PostTagInfo? TagInfo { get; init; }

    [Parameter] public Variant Variant { get; init; } = Variant.Filled;

    [Parameter] public bool? Default { get; init; }

    [Parameter] public bool IsSelected { get; init; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; init; }

    [Parameter] public EventCallback<MudChip<PostTagInfo>> OnClose { get; init; }
}