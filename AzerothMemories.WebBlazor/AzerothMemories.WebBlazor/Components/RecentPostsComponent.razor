<div id="moa-top-header">
    @if (AccountViewModel == null)
    {
    }
    else
    {
        <MudCard Class="@ClassPresets.Card" Outlined="true" Elevation="10">
            <MudCardContent Class="@ClassPresets.PaddingNone">
                <MudSwitch T="bool"
                           Value="@(RecentPostsHelper.SearchResults.PostType != RecentPostType.Default)"
                           Color="Color.Primary" 
                           Class="d-flex justify-end" Label="" 
                           Disabled="AccountViewModel == null"
                           ValueChanged="RecentPostsHelper.OnTryChangeShowAll" />
            </MudCardContent>
        </MudCard>
    }
</div>

@if (RecentPostsHelper.IsLoading)
{
    <CardLoadingComponent />
}
else if (RecentPostsHelper.SearchResults.PostInfos.Length == 0 || RecentPostsHelper.SearchResults.PostViewModels.Length == 0)
{
    <CardInfoComponent Message="None" />
}
else
{
    for (var i = RecentPostsHelper.StartIndex; i < RecentPostsHelper.EndIndex; i++)
    {
        var postIndex = i;
        <PostComponentEx Services="@Services" PostIndex="postIndex" PostInfos="@RecentPostsHelper.SearchResults.PostInfos" PostViewModels="@RecentPostsHelper.SearchResults.PostViewModels" />
    }

    if (RecentPostsHelper.TotalPages > 0)
    {
        <div class="d-flex justify-center @ClassPresets.DefaultPadding">
            <div class="d-block d-sm-none">
                <MudPagination Selected="@RecentPostsHelper.CurrentPage" SelectedChanged="@RecentPostsHelper.OnTryChangePage" BoundaryCount="1" MiddleCount="1" Rectangular="true" Variant="Variant.Filled" ShowFirstButton="false" ShowLastButton="false" Count="@RecentPostsHelper.TotalPages" Size="Size.Small" />
            </div>

            <div class="d-none d-sm-flex">
                <MudPagination Selected="@RecentPostsHelper.CurrentPage" SelectedChanged="@RecentPostsHelper.OnTryChangePage" BoundaryCount="2" MiddleCount="5" Rectangular="true" Variant="Variant.Filled" ShowFirstButton="true" ShowLastButton="true" Count="@RecentPostsHelper.TotalPages" />
            </div>
        </div>
    }
}

@code
{
    [Parameter, EditorRequired] public required IMoaServices Services { get; init; }

    [Parameter, EditorRequired] public required AccountViewModel? AccountViewModel { get; init; }

    [Parameter, EditorRequired] public required RecentPostsHelper RecentPostsHelper { get; init; }
}