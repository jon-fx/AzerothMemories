<div id="moa-top-header">
    @if (AccountViewModel == null || RecentPostsHelper == null)
    {
    }
    else
    {
        <MudCard Class="@ClassPresets.Card" Outlined="true" Elevation="10">
            <MudCardContent Class="@ClassPresets.PaddingNone">
                <MudSwitch T="bool"
                           Value="@(RecentPostsHelper.SearchResults.PostsType != RecentPostsType.Default)"
                           Color="Color.Primary" 
                           Class="d-flex justify-end" Label="" 
                           Disabled="AccountViewModel == null"
                           ValueChanged="RecentPostsHelper.OnTryChangeShowAll" />
            </MudCardContent>
        </MudCard>
    }
</div>

@if (RecentPostsHelper == null || RecentPostsHelper.IsLoading)
{
    <CardLoadingComponent />
}
else if (RecentPostsHelper.SearchResults == null || RecentPostsHelper.SearchResults.PostViewModels == null || RecentPostsHelper.SearchResults.PostViewModels.Length == 0)
{
    <CardInfoComponent Message="None" />
}
else
{
    for (var i = 0; i < RecentPostsHelper.SearchResults.PostViewModels.Length; i++)
    {
        var index = i;
        var post = RecentPostsHelper.SearchResults.PostViewModels[index];
        var postId = $"moa-post-{index}";

        <div id="@postId">
            <PostComponent @key="@postId" Services="@Services" Post="@post" />
        </div>
    }

    <div class="d-flex justify-center @ClassPresets.DefaultPadding">
        <div class="d-block d-sm-none">
            <MudPagination Selected="@RecentPostsHelper.SearchResults.CurrentPage" SelectedChanged="@RecentPostsHelper.OnTryChangePage" BoundaryCount="1" MiddleCount="1" Rectangular="true" Variant="Variant.Filled" ShowFirstButton="false" ShowLastButton="false" Count="@RecentPostsHelper.SearchResults.TotalPages" Size="Size.Small" />
        </div>

        <div class="d-none d-sm-flex">
            <MudPagination Selected="@RecentPostsHelper.SearchResults.CurrentPage" SelectedChanged="@RecentPostsHelper.OnTryChangePage" BoundaryCount="2" MiddleCount="5" Rectangular="true" Variant="Variant.Filled" ShowFirstButton="true" ShowLastButton="true" Count="@RecentPostsHelper.SearchResults.TotalPages" />
        </div>
    </div>
}

@code
{
    [Parameter, EditorRequired] public required IMoaServices Services { get; init; }

    [Parameter, EditorRequired] public required AccountViewModel AccountViewModel { get; init; }

    [Parameter, EditorRequired] public required RecentPostsHelper RecentPostsHelper { get; init; }
}