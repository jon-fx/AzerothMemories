@inject IStringLocalizer<BlizzardResources> _stringLocalizer

@{
    if (LinkDisabled)
    {
        <CharacterNameComponent Inline="true" Typo="@Typo" CharacterName="@CharacterName" CharacterClass="@CharacterClass" />
    }
    else if (CharacterRealmId > 0)
    {
        <a href="character\@CharacterRegionInfo.TwoLettersLower\@CharacterRealmVersion.ToValue()\@_stringLocalizer[$"RealmSlug-{CharacterRealmId}"]\@CharacterName">
            <CharacterNameComponent Inline="true" Typo="@Typo" CharacterName="@CharacterName" CharacterClass="@CharacterClass" />
        </a>
    }
    else if (!string.IsNullOrWhiteSpace(CharacterRealmSlug))
    {
        <a href="character\@CharacterRegionInfo.TwoLettersLower\@CharacterRealmVersion.ToValue()\@CharacterRealmSlug\@CharacterName">
            <CharacterNameComponent Inline="true" Typo="@Typo" CharacterName="@CharacterName" CharacterClass="@CharacterClass" />
        </a>
    }
}

@code {
    [Parameter] public Typo Typo { get; set; } = Typo.body1;
    [Parameter] public bool LinkDisabled { get; init; }
    [Parameter] public int CharacterRealmId { get; set; }
    [Parameter] public string? CharacterRealmSlug { get; set; }
    [Parameter, EditorRequired] public required string CharacterName { get; set; }
    [Parameter, EditorRequired] public required byte CharacterClass { get; set; }
    [Parameter, EditorRequired] public required BlizzardRegionInfo CharacterRegionInfo { get; set; }
    [Parameter, EditorRequired] public required BlizzardRealmVersion CharacterRealmVersion { get; set; }
}