<MudText Inline="@Inline" Typo="@Typo" Class=@($"wowclass-{CharacterClass}")>@CharacterName</MudText>

@code {
    [Parameter, EditorRequired] public required bool Inline { get; init; }
    [Parameter, EditorRequired] public required Typo Typo { get; set; } = Typo.body1;
    [Parameter, EditorRequired] public required string CharacterName { get; set; }
    [Parameter, EditorRequired] public required byte CharacterClass { get; set; }
}