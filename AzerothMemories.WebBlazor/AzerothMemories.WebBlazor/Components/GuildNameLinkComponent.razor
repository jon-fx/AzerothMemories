@inject IStringLocalizer<BlizzardResources> _stringLocalizer

@if (GuildRealmId > 0)
{
    <a href="guild\@GuildRegionInfo.TwoLettersLower\@GuildRealmVersion.ToValue()\@_stringLocalizer[$"RealmSlug-{GuildRealmId}"]\@GuildName">
        <MudText Typo="@Typo" Inline="true">@GuildName</MudText>
    </a>
}
else if (!string.IsNullOrWhiteSpace(GuildRealmSlug))
{
    <a href="guild\@GuildRegionInfo.TwoLettersLower\@GuildRealmVersion.ToValue()\@GuildRealmSlug\@GuildName">
        <MudText Typo="@Typo" Inline="true">@GuildName</MudText>
    </a>
}

@code {
    [Parameter] public Typo Typo { get; set; } = Typo.body1;
    [Parameter] public int GuildRealmId { get; set; }
    [Parameter] public string? GuildRealmSlug { get; set; }
    [Parameter, EditorRequired] public required string GuildName { get; set; }
    [Parameter, EditorRequired] public required BlizzardRegionInfo GuildRegionInfo { get; set; }
    [Parameter, EditorRequired] public required BlizzardRealmVersion GuildRealmVersion { get; set; }
}