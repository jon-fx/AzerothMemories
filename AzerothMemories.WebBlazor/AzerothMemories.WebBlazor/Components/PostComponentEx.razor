@inherits ComputedStateComponent<PostViewModel?>

@{
    var postViewModel = PostViewModel;
    if (postViewModel == null)
    {
        <CardLoadingComponent/>
    }
    else
    {
        var postId = $"moa-post-{postViewModel.Id}";

        <div id="@postId">
            <PostComponent @key="@postId" Services="@Services" Post="@postViewModel" />
        </div>
    }
}

@code
{
    [Parameter, EditorRequired] public new required IMoaServices Services { get; init; }

    [Parameter, EditorRequired] public required int PostIndex { get; init; }

    [Parameter, EditorRequired] public required PostInfo[] PostInfos { get; init; }

    [Parameter, EditorRequired] public required PostViewModel?[] PostViewModels { get; init; }

    private PostViewModel? PostViewModel => PostViewModels[PostIndex];

    protected override async Task<PostViewModel?> ComputeState(CancellationToken cancellationToken)
    {
        var postInfo = PostInfos[PostIndex];
        var locale = ServerSideLocaleExt.GetServerSideLocale();
        PostViewModels[PostIndex] = await Services.ComputeServices.PostServices.TryGetPostViewModel(Services.ClientServices.Session,  postInfo.AccountId, postInfo.PostId, locale);

        return PostViewModels[PostIndex];
    }
}
