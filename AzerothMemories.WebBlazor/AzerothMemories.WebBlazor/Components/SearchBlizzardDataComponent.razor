<AutoCompleteComponent @ref="_autoComplete"
                       @bind-Value="_autoCompleteValue"
                       @bind-Value:after="OnValueChanged"
                       Text="@_autoCompleteText"
                       TextChanged="OnTextChanged"
                       Placeholder="Search tags..."
                       T="PostTagInfo"
                       SearchFunc="SearchMemoryItems"
                       ToStringFunc="ToStringFunc">

    <ItemTemplate Context="e">
        <SearchBlizzardDataChildComponent TagInfo="@e" />
    </ItemTemplate>
</AutoCompleteComponent>

@code
{
    private string? _autoCompleteText;
    private PostTagInfo? _autoCompleteValue;
    private AutoCompleteComponent<PostTagInfo>? _autoComplete;

    [Parameter, EditorRequired] public required IMoaServices Services { get; init; }

    [Parameter, EditorRequired] public required EventCallback<PostTagInfo> OnSelectedItemChanged { get; init; }

    private async Task OnValueChanged()
    {
        if (_autoComplete == null || _autoCompleteValue == null)
        {
            return;
        }

        await OnSelectedItemChanged.InvokeAsync(_autoCompleteValue);

        await _autoComplete.ClearAsync();

        Services.ClientServices.JsRuntime.InvokeVoidAsync("HideWowheadToolTips").CatchAndLog();
    }

    private void OnTextChanged(string text)
    {
        if (text != null)
        {
            _autoCompleteText = text;
        }
    }

    private async Task<IEnumerable<PostTagInfo>> SearchMemoryItems(string searchString, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchString) || searchString.Length < 3)
        {
            return Enumerable.Empty<PostTagInfo>();
        }

        var results = await Services.ComputeServices.TagServices.Search(Services.ClientServices.Session,  searchString, ServerSideLocaleExt.GetServerSideLocale());
        if (cancellationToken.IsCancellationRequested)
        {
            return Enumerable.Empty<PostTagInfo>();
        }

        return results;
    }

    private string ToStringFunc(PostTagInfo? arg)
    {
        if (arg == null)
        {
            return string.Empty;
        }

        return arg.Name;
    }
}